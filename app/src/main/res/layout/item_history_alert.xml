<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="@color/surface"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/outline"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/alertDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jan 12, 2026 • 10:30 PM"
                android:textColor="@color/text_tertiary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/alertStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚨 Fall Detected"
                android:textColor="@color/error_red"
                android:textSize="17sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins_semibold"
                android:layout_marginTop="6dp"/>

            <TextView
                android:id="@+id/resolvedByText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Resolved by: John Doe"
                android:textColor="@color/success_green"
                android:textSize="13sp"
                android:layout_marginTop="8dp"/>

            <Button
                android:id="@+id/btnViewLocation"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginStart="-8dp"
                android:text="View Location"
                android:textColor="@color/primary"
                app:icon="@drawable/location"
                app:iconTint="@color/primary"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
