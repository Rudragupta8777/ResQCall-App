<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:id="@+id/pulseOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#4DDC2626"
        android:visibility="visible" />

    <View
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="130dp"
        android:background="@drawable/gradient_emergency_top"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/alertTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="52dp"
        android:text="🚨 FALL DETECTED"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:textStyle="bold"
        android:fontFamily="@font/poppins_semibold"
        android:letterSpacing="0.02"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        app:cardBackgroundColor="@color/surface"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

            <View
                android:id="@+id/alertDot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/circle_red"
                app:layout_constraintBottom_toBottomOf="@id/wearerNameLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/wearerNameLabel" />

            <TextView
                android:id="@+id/wearerNameLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Rudra Gupta"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins_semibold"
                app:layout_constraintStart_toEndOf="@id/alertDot"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/locationSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Location pinpointed via GPS"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                app:layout_constraintStart_toStartOf="@id/wearerNameLabel"
                app:layout_constraintTop_toBottomOf="@id/wearerNameLabel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRespond"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:text="GET DIRECTIONS"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="@color/on_primary"
                app:icon="@drawable/location"
                app:iconTint="@color/on_primary"
                app:iconGravity="textStart"
                app:backgroundTint="@color/primary"
                app:cornerRadius="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/locationSub" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCall"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:text="CALL WEARER"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="@color/on_error_container"
                app:backgroundTint="@color/error_container"
                app:cornerRadius="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnRespond" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
