<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/statusCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cardContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:foreground="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:padding="18dp">

        <View
            android:id="@+id/avatarBg"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/circle_primary_container"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/avatarInitial"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:gravity="center"
            android:text="U"
            android:textColor="@color/primary"
            android:textSize="18sp"
            android:fontFamily="@font/poppins_semibold"
            app:layout_constraintTop_toTopOf="@id/avatarBg"
            app:layout_constraintBottom_toBottomOf="@id/avatarBg"
            app:layout_constraintStart_toStartOf="@id/avatarBg"
            app:layout_constraintEnd_toEndOf="@id/avatarBg" />

        <TextView
            android:id="@+id/wearerName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="User Name"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textStyle="bold"
            android:fontFamily="@font/poppins_semibold"
            app:layout_constraintTop_toTopOf="@id/avatarBg"
            app:layout_constraintStart_toEndOf="@id/avatarBg"
            app:layout_constraintEnd_toStartOf="@id/batteryRow" />

        <View
            android:id="@+id/pulseDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/circle_green"
            app:layout_constraintBottom_toBottomOf="@id/wearerName"
            app:layout_constraintStart_toEndOf="@id/wearerName"
            app:layout_constraintTop_toTopOf="@id/wearerName" />

        <TextView
            android:id="@+id/lastSeen"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Pulse: Active Now"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="@id/wearerName"
            app:layout_constraintEnd_toStartOf="@id/batteryRow"
            app:layout_constraintTop_toBottomOf="@id/wearerName" />

        <LinearLayout
            android:id="@+id/batteryRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/pill_amber_container"
            android:paddingHorizontal="9dp"
            android:paddingVertical="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/batteryIcon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/battery_full"
                app:tint="@color/on_amber_container" />

            <TextView
                android:id="@+id/batteryPercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="--"
                android:textColor="@color/on_amber_container"
                android:textSize="12sp"
                android:fontFamily="@font/poppins_medium" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/bpmPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/pill_error_container"
            android:paddingHorizontal="9dp"
            android:paddingVertical="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/batteryRow">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_heart"
                app:tint="@color/error_red" />

            <TextView
                android:id="@+id/bpmText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="-- bpm"
                android:textColor="@color/error_red"
                android:textSize="12sp"
                android:fontFamily="@font/poppins_medium" />
        </LinearLayout>

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/cardContentBottomBarrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="avatarBg,lastSeen,bpmPill" />

        <LinearLayout
            android:id="@+id/actionsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            android:weightSum="2"
            app:layout_constraintTop_toBottomOf="@id/cardContentBottomBarrier"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFallHistory"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="12dp"
                android:minWidth="0dp"
                android:text="Fall History"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:letterSpacing="0"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="@font/poppins_medium"
                android:textColor="@color/primary"
                app:strokeColor="@color/primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHealthVitals"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="12dp"
                android:minWidth="0dp"
                android:text="Health Vitals"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:letterSpacing="0"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="@font/poppins_medium"
                android:textColor="@color/on_primary"
                app:backgroundTint="@color/primary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/emergencyActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:orientation="vertical"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/actionsRow"
            app:layout_constraintBottom_toBottomOf="parent">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/outline"
                android:layout_marginBottom="16dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDirections"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Directions"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins_medium"
                    android:textColor="@color/primary"
                    app:strokeColor="@color/primary"
                    app:icon="@drawable/location"
                    app:iconTint="@color/primary"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnResolve"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Resolve"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins_medium"
                    android:textColor="@color/white"
                    app:backgroundTint="@color/success_green"/>
            </LinearLayout>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
